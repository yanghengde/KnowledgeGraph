# Neo4j 连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# Graph Studio 发布本体使用独立 Neo4j database；URI/用户/密码留空时复用上面的连接。
PUBLISH_NEO4J_URI=
PUBLISH_NEO4J_USER=
PUBLISH_NEO4J_PASSWORD=
PUBLISH_NEO4J_DATABASE=graphstudio-model
NEO4J_PASSWORD=your_neo4j_password_here

# Docker 可选配置
NEO4J_IMAGE=neo4j:5.26
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=1g
APP_BIND=0.0.0.0
APP_PORT=5050

# Camstar 源数据库：sqlserver 或 oracle
SRC_DB_TYPE=sqlserver
SRC_DB_HOST=your_src_db_host_here
SRC_DB_PORT=1433
SRC_DB_NAME=CamstarPRD
SRC_DB_USER=your_src_db_user_here
SRC_DB_PASSWORD=your_src_db_password_here
# Oracle 使用；SQL Server 可留空。连接标识支持 service_name 或 sid。
SRC_DB_SCHEMA=
SRC_DB_ORACLE_MODE=service_name

# Camstar 业务 API：仅供受治理的 Action Service 使用；不会直写业务数据库
CAMSTAR_API_BASE_URL=
CAMSTAR_API_USER=
CAMSTAR_API_PASSWORD=
# 如配置 Token，将优先于用户名密码
CAMSTAR_API_TOKEN=
# disabled：只允许 Action 预演；trusted_headers：由可信反向代理注入身份
ACTION_AUTH_MODE=disabled
ACTION_TRUSTED_PROXY_SECRET=

# Graph Studio 同步（运行 doctor/plan 时需要）
GRAPHSTUDIO_BASE_URL=https://graphstudio.example.com
GRAPHSTUDIO_USER=your_graphstudio_user_here
GRAPHSTUDIO_PASSWORD=your_graphstudio_password_here
GRAPHSTUDIO_GRAPHMART_URI=http://cambridgesemantics.com/Graphmart/your_graphmart_id
# Graph Studio 配置库 SPARQL，用于同步 Query Playground 中保存的 Queries。
# 如果与 GRAPHSTUDIO_BASE_URL 共用地址，可留空；自签名证书环境可将 VERIFY_TLS 设为 false。
GRAPHSTUDIO_JOURNAL_URL=
GRAPHSTUDIO_VERIFY_TLS=true
# 必须是 Graph Studio 和 Graph Lakehouse 都可见的共享文件连接
GRAPHSTUDIO_FILE_CONNECTION=http://cambridgesemantics.com/File_Connection/localShare
GRAPHSTUDIO_FILE_PATH=Opcenter2607/CamstarSync

# PostgreSQL 同步控制面：任务、运行记录、检查点和产物注册表
PGSQL_ENABLED=false
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5433
PGSQL_DATABASE=OpcenterGraph
PGSQL_USER=graphsync
PGSQL_PASSWORD=
PGSQL_SSLMODE=prefer
PGSQL_ADMIN_DATABASE=postgres
# 可选的完整 SQLAlchemy URL；设置后优先于上述 PGSQL_* 分项配置
SYNC_STATE_DATABASE_URL=

# SQL Server (Ontology 目标数据库) 连接配置
TGT_DB_HOST=your_tgt_db_host_here
TGT_DB_PORT=1433
TGT_DB_NAME=OntologyDB
TGT_DB_USER=sa
TGT_DB_PASSWORD=your_tgt_db_password_here
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Oracle (Camstar Designer 元数据) 连接配置
ORACLE_DB_HOST=your_oracle_host_here
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE=your_oracle_service_here
ORACLE_DB_USER=your_oracle_user_here
ORACLE_DB_PASSWORD=your_oracle_password_here
ORACLE_DB_SCHEMA=your_camstar_schema_here
# 图谱导入时缓存 CDO 描述目录，避免重复连接数据库（秒）
DESIGNER_CATALOG_CACHE_SECONDS=300

# 日志配置
LOG_LEVEL=INFO

# Chat 问答日志管理
CHAT_LOG_ENABLED=true
CHAT_LOG_DIR=logs/chat
CHAT_LOG_LEVEL=info

# DeepSeek LLM 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
#LLM_MODEL=deepseek-v4-flash
#LLM_MODEL=deepseek-v4-pro

# 图谱导入描述翻译：auto 优先专用翻译服务，其次使用大模型；也可设为 api、llm 或 none
IMPORT_TRANSLATION_PROVIDER=auto
# 可选：兼容 LibreTranslate 请求格式的内网/云端专用翻译接口
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_API_TIMEOUT=30

# 前端图谱高亮与交互配置
GRAPH_MAX_HIGHLIGHT_NODES=50
SHOW_LAYOUT_SWITCH=false

# Wiki 知识库配置
WIKI_REVIEW_REQUIRED=false
# 设为 true 后，LLM 生成的 Wiki 需审核才可对外展示

# Hugging Face 离线模式配置 (消除加载延迟与连接警告)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 是否在问答中显示本体中文简写/名称 (例如 [[Workflow]]（工艺路线）)
SHOW_CN_ALIAS=false
