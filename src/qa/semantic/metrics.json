  "metrics": [
    {
      "id": "container.current_detail",
      "nameZh": "容器当前明细",
      "intent": "detail_query",
      "status": "approved",
      "description": "查询容器当前名称、状态、数量及产品名称。",
      "factTable": "Container",
      "tables": [
        {"table": "Container", "alias": "c"},
        {"table": "Product", "alias": "p"},
        {"table": "ProductBase", "alias": "pb"}
      ],
      "joins": [
        {"left": "c.ProductId", "right": "p.ProductId"},
        {"left": "p.ProductBaseId", "right": "pb.ProductBaseId"}
      ],
      "select": [
        {"expression": "c.ContainerId"},
        {"expression": "c.ContainerName"},
        {"expression": "c.Status"},
        {"expression": "c.Qty"},
        {"expression": "pb.ProductName"}
      ],
      "measures": [],
      "groupBy": [],
      "orderBy": ["c.ContainerId"],
      "requiresTimeRange": false,
      "availableFilters": {
        "status": {"expression": "c.Status", "parameter": "status"},
        "container_id": {"expression": "c.ContainerId", "parameter": "container_id"}
      },
      "limit": 100,
      "businessRules": [
        "Status枚举值未在物理CSV中定义，调用方必须传入已确认的状态参数。"
      ]
    },
    {
      "id": "wip.current_qty",
      "nameZh": "当前容器数量合计",
      "intent": "current_wip",
      "status": "provisional",
      "description": "汇总Container当前快照中的Qty，不推断Status枚举。",
