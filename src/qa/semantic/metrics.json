      "tables": [
        {"table": "Container", "alias": "c"}
      ],
      "joins": [],
      "select": [],
      "measures": [
        {"expression": "SUM(c.Qty)", "alias": "CurrentQty"}
      ],
      "groupBy": [],
      "orderBy": [],
      "requiresTimeRange": false,
      "availableFilters": {},
      "businessRules": [
        "这是Container当前快照的原始数量合计。",
        "由于Status枚举没有权威映射，本指标不自动排除已完成或非活动状态。"
      ]
    },
